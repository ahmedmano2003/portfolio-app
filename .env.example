# ============================================
# قاعدة البيانات PostgreSQL
# ============================================
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/portfolio_db?schema=public"

# ============================================
# NextAuth - مهم جداً يكون سري وعشوائي
# generate: openssl rand -base64 32
# ============================================
AUTH_SECRET="REPLACE_WITH_LONG_RANDOM_STRING_AT_LEAST_32_CHARS"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# ============================================
# Stripe - الدفع الإلكتروني
# اعمل حساب من https://stripe.com
# ============================================
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxx"

# ============================================
# Admin أول مرة - يتم استخدامه في seed
# ============================================
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="Strong_Password_Min_12_Chars!"

# ============================================
# رفع الملفات
# ============================================
UPLOAD_MAX_SIZE_MB=5
ALLOWED_FILE_TYPES="image/jpeg,image/png,image/webp,image/gif"
